{
  "name": "LogLens (Python 3.12 + FastAPI)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "api/index.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements-dev.txt; echo '✅ Packages installed'",
  "postAttachCommand": {
    "api": "uvicorn api.index:app --reload --host 0.0.0.0 --port 8000",
    "web": "python3 -m http.server 3000 --directory public"
  },
  "portsAttributes": {
    "8000": {
      "label": "LogLens API",
      "onAutoForward": "silent"
    },
    "3000": {
      "label": "LogLens UI",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000,
    3000
  ]
}
