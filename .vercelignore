# Tests and local dev files are not part of the deployed function/static site.
tests/
.devcontainer/
.github/
.venv/
venv/
__pycache__/
.pytest_cache/
*.py[cod]

# Local-only tooling and dependencies
generate_sample_log.py
requirements-dev.txt

# Only the repo-root copy is dropped; public/sample_logs/ is what the site serves.
# NOTE: a bare `sample_logs/` would also match public/sample_logs/ (gitignore
# patterns without a leading slash match at any depth), which 404s the demo log.
/sample_logs/

# Markdown other than the README, plus the pitch deck
*.md
!README.md
*.pdf

# Local scratch
.vercel/
.DS_Store
*.tmp

# Local dev launcher
dev.py
